}),s.jsx("p",{className:"mt-1 text-xs leading-relaxed text-muted-foreground",children:y.body}),s.jsx("div",{className:"mt-3 overflow-hidden rounded-xl border border-border",children:s.jsx("table",{className:"w-full text-xs",children:s.jsx("tbody",{children:y.table.rows.map((S,O)=>s.jsxs("tr",{className:O>0?"border-t border-border":"",children:[s.jsx("td",{className:"px-3 py-2 text-muted-foreground",children:S[0]}),s.jsx("td",{className:"px-3 py-2 text-right font-mono2 tnum",style:{color:"#e2dac2"},children:S[1]})]},O))})})})]},y.id))})]})]}),d==="rush"&&s.jsx("div",{children:r?s.jsxs(s.Fragment,{children:[s.jsx("button",{onClick:()=>C(!1),className:"btn-ghost-ind mb-5 px-4 py-2 text-xs",children:"← Назад"}),s.jsx(Op,{onExit:()=>C(!1)})]}):s.jsxs("div",{className:"card-ind p-8 text-center anim-rise",style:{borderColor:"#EC462455"},children:[s.jsx("p",{className:"kicker",style:{color:"#EC4624"},children:"Тренажёр потока"}),s.jsx("h2",{className:"font-display mt-2 text-2xl font-bold",children:"Rush-симулятор"}),s.jsx("p",{className:"mx-auto mt-3 max-w-md text-sm leading-relaxed text-muted-foreground",children:"60 секунд утреннего пика. Гости приходят с заказами, терпение тает. Собирай напитки по шагам из ТТК, обслуживай самые горячие заказы первыми."}),s.jsxs("p",{className:"font-mono2 mt-4 text-sm tnum",style:{color:"#4FBBBC"},children:["Рекорд: ",o.rushBest," гостей"]}),s.jsx("button",{onClick:()=>C(!0),className:"btn-rust anim-pulse-rust mt-6 px-10 py-4 text-sm",children:"Начать смену"})]})})]})}const gm=[{id:"open",title:"Открытие смены",kicker:"Каждый день до первого гостя",items:[{id:"op-1",text:"Форма чистая, значок на месте, руки и ногти в порядке",tip:"Запасная футболка на станции — дешевле, чем «грязный бариста» в отзыве."},{id:"op-2",text:"Проливы групп холостыми, давление и температура машины в норме",tip:"Прогретая группа — стабильный первый шот. Холодная группа врёт по вкусу."},{id:"op-3",text:"Кофемолка: чистый бункер, тестовый помол, сверка с вчерашним журналом",tip:"Влажность за ночь меняет помол. Диалин утром — обязателен, а не «по желанию»."},{id:"op-4",text:"Диалин: 2–3 шота в чашку, вкус и время записаны в журнал",tip:"Цель 18 г → 34–36 мл за 25–30 с. Не угадал — крути помол, а не дозу."},{id:"op-5",text:"Молоко, зерно, сиропы, посуда — сток на 2 часа пика",tip:"Пополнение «до», а не «когда кончилось». Пик не прощает пустого холодильника."},{id:"op-6",text:"Стимер продут, питчеры чистые, тряпки разложены по зонам",tip:"Три тряпки: стимер / бар / столы. Разные цвета — ноль путаницы."},{id:"op-7",text:"Касса и пасс готовы: сдача, чеки, крышки, рукава, салфетки",tip:"Мелочи на пассе решают скорость выдачи в пике сильнее, чем кажется."}]},{id:"hygiene",title:"Гигиена станции в смене",kicker:"Непрерывно, не «в конце»",items:[{id:"hy-1",text:"Стимер: продуть паром и протереть после каждого питчера",tip:"30 секунд промедления = присохшее молоко внутри трубки. Бактерии и запах."},{id:"hy-2",text:"Таблетка выбивается сразу, корзина протирается насухо",tip:"Старая таблетка отдаёт горечь следующему шоту и пачкает сетку группы."},{id:"hy-3",text:"Пролив группы после каждого шота, душ чистый",tip:"Короткий пролив 2 секунды смывает масла — вкус не «плывёт» к обеду."},{id:"hy-4",text:"Руки: мыть после денег, уборки, телефона; перчатки для готовой еды",tip:"Телефон — самая грязная вещь на баре. Правило: взял телефон — вымыл руки."},{id:"hy-5",text:"Молоко не стоит вне холодильника дольше 15 минут",tip:"Тёплое молоко хуже взбивается и быстрее портится. Питчер — из холода."},{id:"hy-6",text:"Пол и зона бара без луж и жмыха каждый час",tip:"Мокрый пол — травма в пике. Убрал сразу — не упал никто."},{id:"hy-7",text:"Аллергены: отдельный питчер/стимер-продув под безлактозное",tip:"Кросс-контакт — реальный риск для гостя. Отдельный питчер решает 90% проблемы."}]},{id:"close",title:"Закрытие смены",kicker:"Смена закрыта — утро спасено",items:[{id:"cl-1",text:"Бэкфлаш всех групп с детергентом, финальные проливы чистой водой",tip:"Слепой диск + детергент, затем вода до исчезновения химии. Ежедневно."},{id:"cl-2",text:"Кофемолка: пустой бункер, щётка, продувка, журнал настроек",tip:"Жернова не моют моющим для посуды. Таблетки для молки — раз в 2 дня."},{id:"cl-3",text:"Стимеры разобраны/продуты, питчеры вымыты и высушены",tip:"Сухой питчер на ночь — без запаха утром."},{id:"cl-4",text:"Остатки молока и сиропов промаркированы датой, просроча — в отход",tip:"Правило: не знаешь дату — это отход. Дешевле вылить, чем отравить."},{id:"cl-5",text:"Журнал закрытия: диалин, поломки, остатки — записано",tip:"Утренняя смена читает журнал за 2 минуты и не гадает."},{id:"cl-6",text:"Стоки посчитаны, заказ на завтра сформирован",tip:"Заказ вечером = нет пустых полок к утреннему пику."}]}],_p=[{id:"dr-1",title:"Опоздание и подмена",level:"major",rule:"Смена начинается вовремя: на баре в форме за 10 минут до открытия. Подмена — только согласованная с управляющим.",why:"Утренний диалин и открытие — командная работа. Один опоздавший = очередь из гостей и сорванный старт.",how:"Будильник с запасом, форма готова с вечера, о подмене писать за сутки. Опаздываешь — звонок до начала смены, а не после."},{id:"dr-2",title:"Телефон на баре",level:"major",rule:"Личный телефон — в локере. На станции только рабочие девайсы.",why:"Телефон — это и гигиена, и внимание. Сообщение в пике = ошибка в заказе.",how:"Договорись с командой: экстренная связь — через управляющего. Проверка телефона — на перерыве."},{id:"dr-3",title:"Внешний вид",level:"minor",rule:"Чистая форма, закрытая обувь, собранные волосы, ногти без лака и длины, минимум украшений.",why:"Бариста — лицо кофейни и зона пищевой безопасности. Волос в чашке — провал аудита.",how:"Чек зеркала перед выходом на бар: 30 секунд. Запасная резинка и фартук — на станции."},{id:"dr-4",title:"Отход от ТТК",level:"critical",rule:"Напитки готовятся строго по ТТК: дозы, объёмы, температуры. «Так привык» — не аргумент.",why:"Гость приходит за повторяемым вкусом. Латте «на глаз» в двух сменах — два разных напитка и возврат доверия.",how:"Не помнишь — открой карточку ТТК, это 15 секунд. Весы и таймер на станции всегда включены."},{id:"dr-5",title:"Просроченные продукты",level:"critical",rule:"Молоко, сиропы, заготовки — по маркировке. Просроча утилизируется сразу, без «понюхай, вроде норм».",why:"Отравление гостя — конец репутации и юридический риск. Ноль компромиссов.",how:"Маркер на каждой открытой упаковке: дата + инициалы. Ревизия холодильника — на открытии и закрытии."},{id:"dr-6",title:"Споры с гостем",level:"major",rule:"Гость недоволен — напиток переделывается без споров и пауз. «Правильная кислотность» не доказывается.",why:"Переделанный капучино стоит 60 ₽. Потерянный постоянный гость — десятки тысяч в год.",how:"Формула: извиниться → переделать → поблагодарить за обратную связь. Разбор — после, в команде."},{id:"dr-7",title:"Чаевые и касса",level:"critical",rule:"Никаких «мимо кассы» и личных расчётов с гостем. Чаевые — по правилам точки.",why:"Это вопрос доверия внутри команды и безопасности бизнеса. Нарушение — увольнение без обсуждений.",how:"Все операции — через кассу, скидки — только по регламенту. Сомневаешься — спроси управляющего до, а не после."},{id:"dr-8",title:"Перерывы и подмена на посту",level:"minor",rule:"Бар не остаётся без человека. Уходишь — позвал подмену, передал очередь заказов.",why:"Один пустой пост в пике = +3 минуты к каждому заказу и нервная смена для всех.",how:"Перерыв по графику, «эстафета» вслух: «у меня 3 заказа в работе, следующий — капучино»."}],Rp={critical:{label:"Критично",color:"#EC4624"},major:{label:"Серьёзно",color:"#F39120"},minor:{label:"Важно",color:"#4FBBBC"}};function Up({id:o}){const d=at(),m=gm.find(D=>D.id===o),[r,C]=Y.useState({}),[y,S]=Y.useState(null),O=new Date().toISOString().slice(0,10),k=(d.checklistsDone[o]||[]).includes(O),B=(d.checklistsDone[o]||[]).length,j=m.items.filter(D=>r[D.id]).length,E=j===m.items.length;return s.jsxs("div",{className:"card-ind overflow-hidden",children:[s.jsxs("div",{className:"p-5",style:{background:"linear-gradient(120deg,#263030,#1e2727)"},children:[s.jsxs("div",{className:"flex items-center justify-between",children:[s.jsxs("div",{children:[s.jsx("p",{className:"kicker",children:m.kicker}),s.jsx("h3",{className:"font-display mt-1 text-base font-bold",children:m.title})]}),k?s.jsx(Bt,{color:"#4FBBBC",children:"сегодня ✓"}):s.jsxs(Bt,{color:"#F39120",children:[j,"/",m.items.length]})]}),s.jsx("div",{className:"mt-3",children:s.jsx(Tt,{value:k?100:j/m.items.length*100,color:k?"#4FBBBC":"#F39120"})}),s.jsxs("p",{className:"mt-2 font-mono2 text-[10px] tnum text-muted-foreground",children:["выполнено раз: ",B]})]}),s.jsx("div",{className:"divide-y divide-border",children:m.items.map(D=>{const H=k||!!r[D.id];return s.jsxs("div",{className:"px-4 py-3",children:[s.jsxs("label",{className:"flex cursor-pointer items-start gap-3",children:[s.jsx("input",{type:"checkbox",disabled:k,checked:H,onChange:()=>C(V=>({...V,[D.id]:!V[D.id]})),className:"mt-0.5 h-5 w-5 shrink-0 accent-[#4FBBBC]"}),s.jsx("span",{className:`flex-1 text-sm ${H?"opacity-50 line-through":""}`,style:{color:"#c9c0a6"},children:D.text}),s.jsx("button",{type:"button",onClick:()=>S(y===D.id?null:D.id),className:"shrink-0 rounded-full px-2 py-0.5 text-[10px] font-bold",style:{background:"#1a2121",color:"#F39120"},children:"как соблюдать"})]}),y===D.id&&s.jsx("p",{className:"anim-rise ml-8 mt-2 rounded-xl p-3 text-xs leading-relaxed",style:{background:"#1a2121",color:"#c9c0a6",border:"1px solid #F3912044"},children:D.tip})]},D.id)})}),!k&&s.jsx("div",{className:"p-4",children:s.jsx("button",{disabled:!E,onClick:()=>Ne.completeChecklist(o),className:"btn-aqua w-full px-4 py-3 text-sm disabled:cursor-not-allowed disabled:opacity-30",children:E?"Закрыть чек-лист · +30 XP":`Осталось ${m.items.length-j} пунктов`})})]})}function Hp(){const[o,d]=Y.useState("checks");return s.jsxs("div",{className:"space-y-6",children:[s.jsxs("div",{className:"anim-rise",children:[s.jsx("p",{className:"kicker",children:"Стандарты и дисциплина"}),s.jsx("h1",{className:"font-display mt-2 text-3xl font-bold",children:"Дисциплина станции"}),s.jsx("p",{className:"mt-2 max-w-2xl text-sm text-muted-foreground",children:"Рабочие чек-листы смены и дисциплинарные требования — с конкретными рекомендациями, как их соблюдать без лишних нервов."})]}),s.jsxs("div",{className:"flex gap-2 anim-rise",children:[s.jsx("button",{onClick:()=>d("checks"),className:`chip-ind px-4 py-2 text-xs ${o==="checks"?"on":""}`,children:"Чек-листы"}),s.jsx("button",{onClick:()=>d("rules"),className:`chip-ind px-4 py-2 text-xs ${o==="rules"?"on":""}`,children:"Требования"})]}),o==="checks"&&s.jsx("div",{className:"space-y-4",children:gm.map(m=>s.jsx(Up,{id:m.id},m.id))}),o==="rules"&&s.jsx("div",{className:"space-y-3",children:_p.map(m=>{const r=Rp[m.level];return s.jsxs("details",{className:"card-ind group overflow-hidden anim-rise",children:[s.jsxs("summary",{className:"flex cursor-pointer items-center gap-3 p-4",children:[s.jsx("span",{className:"h-2.5 w-2.5 shrink-0 rounded-full",style:{background:r.color}}),s.jsxs("div",{className:"min-w-0 flex-1",children:[s.jsx("p",{className:"text-sm font-bold",children:m.title}),s.jsx("p",{className:"truncate text-xs text-muted-foreground",children:m.rule})]}),s.jsx(Bt,{color:r.color,children:r.label})]}),s.jsxs("div",{className:"space-y-3 border-t border-border p-4",style:{background:"#1a2121"},children:[s.jsxs("div",{children:[s.jsx("p",{className:"kicker",children:"Требование"}),s.jsx("p",{className:"mt-1 text-sm leading-relaxed",style:{color:"#c9c0a6"},children:m.rule})]}),s.jsxs("div",{children:[s.jsx("p",{className:"kicker",style:{color:"#EC4624"},children:"Зачем это"}),s.jsx("p",{className:"mt-1 text-sm leading-relaxed",style:{color:"#c9c0a6"},children:m.why})]}),s.jsxs("div",{className:"rounded-xl p-3",style:{background:"#4FBBBC14",border:"1px solid #4FBBBC44"},children:[s.jsx("p",{className:"kicker",style:{color:"#4FBBBC"},children:"Как соблюдать"}),s.jsx("p",{className:"mt-1 text-sm leading-relaxed",style:{color:"#c9c0a6"},children:m.how})]})]})]},m.id)})})]})}const Yu=[{id:"latte",title:"Латте-арт",kicker:"Молоко и паттерны",blurb:"Микропена, сердце, тюльпан, розетта, лебедь. Видео, фото и методика 202f.",cover:"/lessons/latte-heart.jpg",lessonIds:["latte-milk","latte-heart","latte-tulip","latte-rosetta","latte-swan","latte-faults"]},{id:"v60",title:"V60",kicker:"Конический пуровер",blurb:"Спираль, блум и контроль потока. Рецепт ТТК: 18 г → ~300 мл, 2:45–3:00.",cover:"/lessons/v60.jpg",lessonIds:["v60-method","v60-video","v60-kasuya","filter-compare"]},{id:"kalita",title:"Kalita Wave 185",kicker:"Плоское дно",blurb:"Три отверстия, ровный слой, пульсы. ТТК: 21 г → 320 мл, блум 30–40 г.",cover:"/lessons/kalita.jpg",lessonIds:["kalita-method","kalita-video"]},{id:"aeropress",title:"Aeropress",kicker:"Иммерсия + давление",blurb:"Короткий цикл. ТТК: 18 г, два фильтра, пресс 40–50 с. На смене — не inverted.",cover:"/lessons/aeropress.jpg",lessonIds:["aero-method"]},{id:"coldbrew",title:"Cold brew",kicker:"Холодная экстракция",blurb:"ТТК: 90 г на 1 л, 17–24 ч, порция 150–180 мл.",cover:"/lessons/coldbrew.jpg",lessonIds:["coldbrew-method"]},{id:"service",title:"Сервис",kicker:"Гость и допродажи",blurb:"Четыре шага контакта, одно предложение, жалобы и аллергии.",cover:"/lessons/service.jpg",lessonIds:["service-method","service-complaints","service-phrases"]},{id:"bar",title:"Работа в баре",kicker:"Станция и пик",blurb:"Mise en place, узкие места потока, чистка, эспрессо.",cover:"/lessons/bar-peak.jpg",lessonIds:["bar-method","bar-peak","espresso-visual","espresso-dial"]},{id:"grind",title:"Помол",kicker:"Жернова и фракция",blurb:"Помол — главный рычаг экстракции. Файнсы, нагрев жерновов, график чистки.",cover:"/lessons/grind.jpg",lessonIds:["grind-method"]},{id:"sensory",title:"Сенсорика",kicker:"Каппинг и колесо",blurb:"Протокол SCA, треугольный тест, от «фруктовый» к конкретной ноте.",cover:"/lessons/cupping.jpg",lessonIds:["sensory-cupping"]},{id:"roast",title:"Обжарка",kicker:"Сушка, Майяр, развитие",blurb:"Три фазы и DTR — чтобы говорить с обжарщиком, а не самому крутить барабан.",cover:"/lessons/roast.jpg",lessonIds:["roast-phases"]},{id:"origin",title:"Происхождение",kicker:"Регион и обработка",blurb:"Как коротко объяснить гостю, почему Эфиопия ягодная, а Бразилия ореховая.",cover:"/lessons/origin-map.jpg",lessonIds:["origin-guest"]},{id:"water",title:"Вода",kicker:"SCA Water Standard",blurb:"Жёсткость, щёлочность, TDS. Фильтр по счётчику, не на глаз.",cover:"/lessons/water.jpg",lessonIds:["water-sca"]},{id:"systems",title:"Системы",kicker:"PRO-уровень",blurb:"PDCA, метрики чека, SBI, калибровка команды.",cover:"/lessons/books.jpg",lessonIds:["systems-method"]},{id:"books",title:"Книги и SCA",kicker:"Полка академии",blurb:"Карты чтения Rao, Hoffmann, Water for Coffee и CSP — без пиратства.",cover:"/lessons/books.jpg",lessonIds:["book-hoffmann","book-rao","book-sca","book-202f"]}],Ru=[{id:"latte-milk",topicId:"latte",title:"Микропена",kind:"method",duration:"8 мин",cover:"/lessons/milk.jpg",summary:"Рисунок держится на текстуре. Сначала молоко, потом рука. Растяжка — секунды, закрутка — до глянца.",youtube:{id:"oaKRBBpA4fw",title:"James Hoffmann — Everything You Need To Know To Steam Great Milk"},recipe:{rows:[["Старт молока","4 °C из холодильника"],["Финал","55–65 °C, не выше 70 °C"],["Звук","Ровное «шшш», без хлопков"],["Капучино","Больше воздуха, плотнее шапка"],["Латте / флэт","Минимум пены, максимум плотности"]]},sections:[{title:"Два этапа",steps:["Растяжка: носик у поверхности, воздух только в первые секунды.","Закрутка: носик ниже поверхности, вихрь перемалывает пузыри в микропену и греет равномерно.","Стук питчера и круговое вращение — снять крупные пузыри, полировать глянец.","Лить сразу: микропена расслаивается за десятки секунд."]},{title:"Если рисунок рвётся",body:"В 9 случаях из 10 это молоко или эспрессо, не «рука». Крупные пузыри — слишком долгая растяжка. Сухое дно чашки — мало пены или перегрев. Серый, тусклый крема — слабый шот."}]},{id:"latte-heart",topicId:"latte",title:"Сердце",kind:"visual",duration:"6 мин",cover:"/lessons/latte-heart.jpg",summary:"Базовый паттерн. Переход дальше — только после 8 из 10 стабильных сердец.",youtube:{id:"kVEvII6YalE",title:"Lance Hedrick — The Ultimate Guide to Latte Art (2× World Champion)"},sections:[{title:"Пролив",steps:["Высокий тонкий поток в центр — смешать базу, не оставляя белого пятна.","Опустить носик почти к поверхности, увеличить поток — белая точка растёт.","Когда точка заняла ~⅔ чашки, тонкая протяжка через центр на себя — «замок» сердца.","Не качать питчер. Сердце = прямой пролив + финальное движение."]}]},{id:"latte-tulip",topicId:"latte",title:"Тюльпан",kind:"visual",duration:"7 мин",cover:"/lessons/latte-tulip.jpg",summary:"Серия толчков. Каждый слой меньше предыдущего. Ключ — пауза и объём, не скорость.",youtube:{id:"c-zuecTxEeI",title:"Dritan Alsela — Latte Art Basics: Heart, Rosetta, Tulip"},sections:[{title:"Толчки",steps:["База как у сердца: высокий пролив, затем низко в центр.","Короткий толчок — стоп. Сдвинуть питчер чуть на себя.","Второй толчок в предыдущий слой, меньше объёмом.","Третий — ещё меньше. Финальная протяжка через все слои."]}]},{id:"latte-rosetta",topicId:"latte",title:"Розетта",kind:"visual",duration:"8 мин",cover:"/lessons/latte-rosetta.jpg",summary:"Покачивание + равномерный отход. Амплитуда стабильная, скорость отхода ровная.",youtube:{id:"jYq1pHJYQmw",title:"Dritan Alsela — Latte Art Basics in Slow Motion (Heart, Rosetta, Tulip)"},sections:[{title:"Качание и отход",steps:["База в центр. Опустить носик, начать узкое покачивание.","Не увеличивать амплитуду к краям — это рвёт листья.","Одновременно отходить назад с постоянной скоростью.","В конце — тонкая протяжка через стержень розетты, как у сердца."]}]},{id:"v60-method",topicId:"v60",title:"Метод V60",kind:"method",duration:"10 мин",cover:"/lessons/v60.jpg",recipe:{rows:[["Доза","18 г"],["Фильтр","1 × V60"],["Выход","~300 мл"],["Блум","30–40 г"],["Пролив","100 мл, затем 150–160 мл"],["Время","2:45–3:00"]]},summary:"Рецепт ТТК. Конус, спираль от центра, не лить на бумагу. Если стекает быстрее 2:45 — помол крупный.",youtube:{id:"1oB1oDrDkHM",title:"James Hoffmann — A Better 1 Cup V60 Technique"},sections:[{title:"Цикл",steps:["Ополоснуть фильтр, прогреть воронку и сервер, слить воду.","Засыпать кофе, встряхнуть слой, сделать лунку в центре.","Блум: намочить всю массу, подождать оседания корки.","Основной пролив спиралью, уровень держать стабильным.","Последние граммы — в центр. Не разбивать стенки."]},{title:"Вкус → настройка",body:"Кисло и слабо — помол мельче, выше температура или крепче соотношение. Горько и вяжет — крупнее помол, чуть ниже температура, не заливать края."}]},{id:"v60-video",topicId:"v60",title:"Hoffmann: Ultimate V60",kind:"video",duration:"11 мин",cover:"/lessons/v60.jpg",youtube:{id:"AI4ynXzkSQo",title:"James Hoffmann — The Ultimate V60 Technique"},summary:"Эталон индустрии: 30 г / 500 г, блум, основной пролив, лёгкое помешивание и финальный свирл. Смотрите, затем повторите на дозе станции.",sections:[{title:"Зачем смотреть",body:"Хоффманн показывает, почему воронка должна быть ровной и зачем свирл в конце выравнивает слой. Не копируйте 500 г на смене — цифры станции из ТТК: 18 г → ~300 мл, 2:45–3:00."}]},{id:"v60-kasuya",topicId:"v60",title:"Kasuya: метод 4:6",kind:"video",duration:"4 мин",cover:"/lessons/v60.jpg",youtube:{id:"wmCW8xSWGZY",title:"Tetsu Kasuya — 4:6 Method (World Brewers Cup 2016, HARIO Official)"},summary:"Чемпионский рецепт: вкус делится на кислотность (первые 40% воды) и сладость (остальные 60%). Пять пульсов, полный слив между ними.",sections:[{title:"Зачем смотреть",body:"Тэцу Касуя выиграл World Brewers Cup 2016 этим методом. На станции 202f держим Hoffmann как базу. 4:6 — когда гость просит «кислее» или «слаще»: меняете только первые два пульса, не весь рецепт."}]},{id:"kalita-method",topicId:"kalita",title:"Kalita Wave 185",kind:"method",duration:"9 мин",cover:"/lessons/kalita.jpg",youtube:{id:"6x6YdlAmWLA",title:"Stumptown Coffee Roasters — How to Brew Coffee in a Kalita Wave"},recipe:{rows:[["Доза","21 г"],["Фильтр","1 × Kalita Wave 185"],["Выход","320 мл"],["Блум","30–40 г"],["Пролив","120 мл, затем 150–160 мл"],["Стенки","Не лить на волны фильтра"]]},summary:"Рецепт ТТК. Плоское дно и три отверстия. Слой ровный — спокойнее конуса на потоке.",sections:[{title:"Почему Wave",body:"Фильтр стоит на рёбрах, воздух выходит по кругу, дно не присасывается. Три отверстия ограничивают скорость: пролив не «проваливается», как в конусе."},{title:"Пульсы",steps:["Ополоснуть волнистый фильтр — иначе бумажный вкус и щели по краю.","Блум 30–40 г по всему плоскому слою, не только в центр.","Первый пролив 120 мл.","Второй 150–160 мл до 320 мл. Не лить на волны фильтра."]}]},{id:"aero-method",topicId:"aeropress",title:"Aeropress",kind:"method",duration:"8 мин",cover:"/lessons/aeropress.jpg",youtube:{id:"j6VlT_jUVPc",title:"James Hoffmann — The Ultimate AeroPress Technique"},recipe:{rows:[["Доза","18 г"],["Фильтр","2 × Aeropress"],["Стир","10–15 с"],["Пресс","медленно 40–50 с"],["Ориентация","Обычная, не inverted"]]},summary:"Рецепт ТТК. На смене — обычная ориентация: быстрее и безопаснее в пике.",sections:[{title:"Почему не inverted на станции",body:"Классическая ориентация быстрее, безопаснее и стабильнее в пике. Переворот — для экспериментов, не для очереди из шести человек."},{title:"Цикл",steps:["Два фильтра в крышку, ополоснуть, собрать цилиндр на чашке.","18 г, залить, перемешать 10–15 с.","Прессовать медленно 40–50 с до шипения воздуха. Не дожимать жмых всухую."]}]},{id:"service-method",topicId:"service",title:"Четыре шага и одно предложение",kind:"method",duration:"7 мин",cover:"/lessons/service.jpg",youtube:{id:"OXbQx2hfA5k",title:"James Hoffmann — Bad Coffee In A Cafe: What Should You Do?"},summary:"Встреча → потребность → одна рекомендация → прощание. Повтор после отказа — навязчивость. В пике предложение пропускают.",sections:[{title:"Алгоритм",steps:["Встреча: взгляд и приветствие за 5–10 секунд.","Потребность: молоко / крепче-мягче / с собой, если заказ не очевиден.","Предложение: одна релевантная позиция как совет, не как скрипт.","Прощание: имя, если есть, и открытая фраза «возвращайтесь»."]},{title:"Формулировки",body:"Не «ещё что-то?». Да: «К рафу хорошо идёт чизкейк — добавить?». Не спорить о цене — ценность и альтернатива. Жалоба на напиток: переделать сразу, разбор после смены."}]},{id:"bar-method",topicId:"bar",title:"Станция, пик, чистка",kind:"method",duration:"9 мин",cover:"/lessons/bar.jpg",summary:"Узкое место — обычно молоко или касса. Усиливать его. Буфер расходников на весь пик. Журнал чистки — не формальность.",recipe:{rows:[["Пролив группы","После каждого шота"],["Стимер","Сразу после молока"],["Бэкфлаш","Конец смены, все рабочие группы"],["Гриндер","Раз в 2 дня + журнал"],["Душ группы","Еженедельно снять и замочить"]]},sections:[{title:"Пик",steps:["Пропускать допродажу, если гость спешит.","Заранее: помол под фильтр, чашки, молоко из холодильника.","Не делить людей поровну — стоять на бутылочном горлышке.","Стажёра учить одному циклу за раз."]}]},{id:"espresso-visual",topicId:"bar",title:"Эспрессо: кадр и цифры",kind:"visual",duration:"5 мин",cover:"/lessons/espresso.jpg",youtube:{id:"xb3IxAr4RCo",title:"James Hoffmann — How I Make Espresso: Tools and Techniques"},recipe:{rows:[["Доза","18 г"],["Выход","34–36 мл"],["Ratio","1:2"],["Время","25–30 с"]]},summary:"Рецепт ТТК. 18 г → 34–36 мл, 1:2, 25–30 с. Каналы лечатся распределением, не силой темпинга.",sections:[{title:"Последовательность",steps:["Прогреть чашку и холдер. Сухая корзина.","Помол → дистрибьют → ровный темпинг → сразу в группу.","Стоп по весу, не по цвету струи.","Выбить, пролить группу, протереть корзину."]}]},{id:"systems-method",topicId:"systems",title:"PDCA, метрики, SBI",kind:"method",duration:"8 мин",cover:"/lessons/books.jpg",summary:"PRO строит систему, а не исполняет скрипт. Пилот ≥ 2 недель. Одна переменная. Чек вырос и NPS упал — ложный успех.",sections:[{title:"Считать",body:"Средний чек = выручка / чеки. Attachment rate = чеки с допом / все чеки. Конверсия предложения = согласия / сделанные предложения. Сравнивать только сопоставимые периоды."},{title:"SBI",body:"Ситуация — поведение — влияние. «В пик в 9:15 ты не сделал предложение первым пяти, и мы упустили 2–3 чека». Без перехода на личность. Та же схема работает как признание."}]},{id:"book-hoffmann",topicId:"books",title:"World Atlas of Coffee",kind:"book",duration:"карта чтения",cover:"/lessons/book-hoffmann.jpg",summary:"Джеймс Хоффманн. Не конспект — карта: как читать происхождение и обработку, чтобы объяснять гостю без лекции.",sections:[{title:"Как пользоваться",steps:["Глава про обработку: мытая / натуральная / хани — держать в одном абзаце для гостя.","Регионы: 2–3 якоря на текущее меню, не весь атлас.","После чтения региона — слепой каппинг лота с этой страны."]},{title:"Права",body:"Полный текст книги в академию не копируется. Купите бумагу или легальный e-book. Здесь — маршрут изучения под смену 202f."}]},{id:"book-rao",topicId:"books",title:"Rao: Handbook & Everything but Espresso",kind:"book",duration:"карта чтения",cover:"/lessons/book-rao.jpg",summary:"Professional Barista's Handbook — эспрессо и молоко. Everything but Espresso — контроль экстракции фильтра. DTR и фазы обжарки — разговор с обжарщиком.",sections:[{title:"Что вынести на станцию",steps:["Один параметр за раз при диалине.","Распределение важнее силы темпинга.","Brewing control chart: TDS × EY, не «крепче = лучше»."]}]},{id:"book-sca",topicId:"books",title:"SCA Coffee Skills Program",kind:"book",duration:"модули",cover:"/lessons/book-sca.jpg",summary:"Barista Skills, Brewing, Sensory, Green, Roasting. Внутренняя аттестация 202f рифмуется с CSP, но не заменяет сертификат.",sections:[{title:"Соответствие",body:"Ступени 1 и 3 → Barista Skills. Ступень 4 → Brewing + Sensory. PRO → Roasting (фазы, DTR) и сенсорные протоколы (треугольник, каппинг)."}]},{id:"book-202f",topicId:"books",title:"Пять ступеней мастерства",kind:"book",duration:"пособие сети",cover:"/lessons/book-202f.jpg",summary:"Внутреннее пособие 202f: сервис → оборудование → эспрессо и молоко → фильтр и сенсорика → аттестация. PRO-том: системы, менеджмент, презентация.",sections:[{title:"Где в приложении",body:"Путь Junior / Skilled / PRO закрывает пособие чек-листами и тестами. Эта библиотека — методики, видео и полка рядом с путём."}]},{id:"latte-swan",topicId:"latte",title:"Лебедь",kind:"visual",duration:"8 мин",cover:"/lessons/latte-swan.jpg",youtube:{id:"m55ylEGqGmo",title:"European Coffee Trip — How To Pour Swan (Dávid Štefánik)"},summary:"Розетта + шея и голова. Сначала уверенная розетта, потом точечный пролив и протяжка. PRO-паттерн.",sections:[{title:"Сборка",steps:["База и розетта смещены чуть от центра — место под шею.","Остановить качание, тонкая протяжка формирует шею.","Капля у края — голова. Зубочистка или спайдер — клюв, если пролив не закрыл форму.","Контраст и симметрия важнее «похожести на птицу»."]}]},{id:"filter-compare",topicId:"v60",title:"V60, Kalita, Aeropress — когда что",kind:"method",duration:"6 мин",cover:"/lessons/v60.jpg",youtube:{id:"ipB6P1uzNYM",title:"James Hoffmann — Coffee Brewing Ratios Explained"},summary:"Только методы из ТТК. Конус — яркость. Плоское дно — поток. Aeropress — короткий цикл.",sections:[{title:"Выбор на смене",body:"Гость хочет «поярче и ягоднее» — V60, 18 г → ~300 мл. Поток фильтров — Kalita 185, 21 г → 320 мл. Короткий цикл или крепче тело — Aeropress, 18 г, два фильтра."},{title:"Помол",steps:["V60 — средне-мелкий, 2:45–3:00.","Kalita 185 — чуть крупнее, слой плоский, не лить на волны.","Aeropress — средне-мелкий, пресс 40–50 с, не inverted."]}]},{id:"kalita-video",topicId:"kalita",title:"Stumptown: Kalita Wave",kind:"video",duration:"4 мин",cover:"/lessons/kalita.jpg",youtube:{id:"6x6YdlAmWLA",title:"Stumptown Coffee Roasters — How to Brew Coffee in a Kalita Wave"},summary:"Эталон плоского дна от Stumptown: ровный слой, центр, без размывания волны. После просмотра — ТТК: 21 г → 320 мл.",sections:[{title:"Как смотреть",body:"Перенесите геометрию: плоский слой, не лить на рёбра волны. Цифры только из ТТК: 21 г, блум 30–40 г, пролив 120 мл, затем 150–160 мл до 320 мл."}]},{id:"coldbrew-method",topicId:"coldbrew",title:"Концентрат cold brew",kind:"method",duration:"6 мин",cover:"/lessons/coldbrew.jpg",youtube:{id:"PApBycDrPo0",title:"James Hoffmann — Better than cold brew: How to make iced filter coffee"},recipe:{rows:[["Доза","90 г на 1 л"],["Помол","Крупный"],["Время","17–24 ч в холодильнике"],["Порция","150–180 мл"],["Хранение","до 5 дней"]]},summary:"Рецепт ТТК. Долгая холодная экстракция. Мало кислоты, плотное тело. Не замена фильтра — другой напиток, честно сказать гостю.",sections:[{title:"Станция",steps:["Крупный помол, 90 г на литр холодной фильтрованной воды.","Настаивать 17–24 ч в холодильнике, отфильтровать.","Порция 150–180 мл, холодным. Хранить герметично до 5 дней. FIFO.","Гостю: «меньше кислит, больше шоколада и тела» — без слова «крепче»."]}]},{id:"service-complaints",topicId:"service",title:"Жалобы, аллергии, «волосок»",kind:"method",duration:"7 мин",cover:"/lessons/service.jpg",youtube:{id:"OXbQx2hfA5k",title:"James Hoffmann — Bad Coffee In A Cafe: What Should You Do?"},summary:"Переделать сразу. Не спорить при госте. Аллергия — смена питчера и стимера, без обещания абсолютного нуля.",sections:[{title:"Напиток «не тот»",steps:["Извиниться, убрать чашку, переделать без дискуссии о вкусе.","Уточнить: кислота, горечь, температура, молоко.","Разбор причины — после смены, в журнале."]},{title:"Посторонний предмет",body:"Не рассматривать при всех. Новая чистая посуда. Сообщить старшему. Улику не выбрасывать до фиксации."},{title:"Аллергия",body:"Лактоза, орехи, сиропы. Сменить питчер, продуть и протереть стимер. Если общий пар — честно сказать про кросс-контакт и предложить безопасный напиток."}]},{id:"service-phrases",topicId:"service",title:"Фразы на стойке",kind:"method",duration:"5 мин",cover:"/lessons/service.jpg",summary:"Готовые формулировки. Одна мысль — одно предложение. Без «ещё что-нибудь?».",sections:[{title:"Вместо пустых вопросов",steps:["Не «вам что-нибудь ещё?». Да: «К рафу хорошо идёт чизкейк — добавить?»","Не «какой кофе любите?». Да: «Кислее и ягоднее — фильтр, мягче — с молоком. Куда ближе?»","Не «это премиум». Да: «Этот лот ягодный, как смородина. Если любите шоколад — лучше вот этот.»"]},{title:"Отказ и цена",body:"Не спорить. Ценность и альтернатива: «Понял. Тогда классический капучино — тот же эспрессо, привычнее по молоку.» Второй заход после отказа — навязчивость."}]},{id:"bar-peak",topicId:"bar",title:"Mise en place в пик",kind:"visual",duration:"6 мин",cover:"/lessons/bar-peak.jpg",summary:"Узкое место — молоко или касса. Буфер стаканов, молока и сиропов на весь пик. Не делить людей поровну.",sections:[{title:"До пика",steps:["Молоко из холодильника порционно, питчеры чистые.","Помол фильтра, прогрев чашек, запас холдеров.","Сиропы, крышки, трубочки — в зоне кассы, не бегать."]},{title:"Во время",body:"Пропускать допродажу, если гость спешит. Один бариста на бутылочном горлышке. Стажёр — один цикл, не «помогай везде»."}]},{id:"sensory-cupping",topicId:"sensory",title:"Каппинг SCA",kind:"method",duration:"10 мин",cover:"/lessons/cupping.jpg",youtube:{id:"cSEgP4VNynQ",title:"James Hoffmann — How To Cup (Taste) Coffee At Home"},recipe:{rows:[["Доза","8,25 г на 150 мл ≈ 1:18"],["Помол","Среднекрупный, <15 мин до заливки"],["Вода","~93 °C"],["Корка","Разбивка на 4-й минуте"]]},summary:"Сначала молча. Потом общий словарь. Треугольник — чтобы доказать, что разница ощутима, а не додумана.",sections:[{title:"Протокол",steps:["Залить, не размешивая. Оценить сухой аромат.","На 4-й минуте три движения ложкой, снять пену.","Дегустация после остывания, с втягиванием.","10 категорий, 100 баллов. Сначала свои слова, потом колесо вкусов."]},{title:"Треугольник",body:"Три чашки: две одинаковые, одна с изменённым параметром. Найти лишнюю. Так калибруют команду и защищают метод на PRO."}]},{id:"water-sca",topicId:"water",title:"Вода под экстракцию",kind:"method",duration:"6 мин",cover:"/lessons/water.jpg",youtube:{id:"jfElZfrmlRs",title:"James Hoffmann — The Best Water for Coffee"},recipe:{rows:[["Хлор / запах","Нет"],["Жёсткость CaCO₃","50–175 ppm"],["Щёлочность","40–70 ppm"],["TDS","75–250, ориентир 150"],["pH","~7"]]},summary:"Вода ломает вкус и машину. Картридж — по литрам и дате в журнале, не когда «уже невкусно».",sections:[{title:"На смене",body:"Если шоты стали плоскими при том же помоле — проверьте фильтр и накипь раньше, чем винить зерно. Дистиллят (0 ppm) даёт пустую чашку. Слишком жёсткая вода — накипь и глухая сладость."}]},{id:"latte-faults",topicId:"latte",title:"Почему рисунок не держится",kind:"visual",duration:"6 мин",cover:"/lessons/latte-faults.jpg",youtube:{id:"gTC3dJvwgUI",title:"Lance Hedrick — How To Steam Milk for Latte Art (2× World Champion)"},summary:"Серый крема, крупные пузыри, сухая кромка. Сначала молоко и эспрессо, потом рука.",sections:[{title:"Диагностика",steps:["Крупные пузыри — растяжка слишком долгая или носик слишком высоко.","Молоко «крупа» — перегрев выше 70 °C.","Рисунок тонет сразу — эспрессо водянистый или мало пены.","Нет контраста — база не смешана высоким проливом в начале.","Рваный край — поток скачет, питчер дрожит, чашка не стоит ровно."]}]},{id:"espresso-dial",topicId:"bar",title:"Диалин: один параметр",kind:"visual",duration:"7 мин",cover:"/lessons/espresso-dial.jpg",youtube:{id:"lFwJF-_SUr0",title:"James Hoffmann — How I Dial-In Espresso, Part 1"},recipe:{rows:[["Фиксируем","Доза и выход"],["Двигаем","Помол"],["Кисло / водянисто","Мельче"],["Горько / сухо","Крупнее"]]},summary:"Весы, время, вкус. Не крутить помол, дозу и температуру одновременно — потом не понять, что сработало.",sections:[{title:"Порядок",steps:["Записать дозу, выход, время, вкус одним словом.","Изменить только помол на один щелчок.","Два шота подряд — подтвердить, что это не канал.","В журнал дня: финальные цифры для всей смены."]}]},{id:"grind-method",topicId:"grind",title:"Помол и жернова",kind:"method",duration:"7 мин",cover:"/lessons/grind.jpg",youtube:{id:"er2voEn8ZDU",title:"James Hoffmann — Understanding Espresso: Grind Size"},summary:"Помол задаёт время и равномерность. Нагрев жерновов в пике «ускоряет» шот — это не новое зерно.",sections:[{title:"На смене",steps:["Свежий помол в холдер, не заранее в стакан на 20 минут.","Если шоты поехали быстрее без смены зерна — жернова греются, подкрутить мельче.","Файнсы в воронке — прогорклость и каналы. Чистка раз в 2 дня.","Эспрессо и фильтр — разные молки или обязательная продувка при смене."]}]},{id:"roast-phases",topicId:"roast",title:"Три фазы и DTR",kind:"method",duration:"9 мин",cover:"/lessons/roast.jpg",youtube:{id:"N6BJVM5tvnw",title:"James Hoffmann — Coffee Roasting Explained"},recipe:{rows:[["Сушка","~35–45% времени, до ~150 °C"],["Майяр","150–200 °C до первого крека"],["Развитие","От 1-го крека до сброса"],["DTR","Ориентир 15–25% от общего времени"]]},summary:"PRO-бариста не обжаривает — диагностирует чашку и говорит с обжарщиком на одном языке.",sections:[{title:"След в чашке",steps:["Короткая сушка — трава, пустое тело.","Короткий DTR — кислота, сорт, риск непроявленной сладости.","Длинный DTR — меньше сорта, дым, горечь.","DTR — ориентир, не стандарт SCA. Важно направление, не одна цифра."]}]},{id:"origin-guest",topicId:"origin",title:"Регион за 15 секунд",kind:"method",duration:"6 мин",cover:"/lessons/origin-map.jpg",youtube:{id:"O9YnLFrM7Fs",title:"James Hoffmann — A Beginner's Guide To Buying Great Coffee"},summary:"Гостю не нужен атлас. Нужны два якоря: обработка и ожидаемый вкус текущего лота.",sections:[{title:"Шпаргалка",body:"Эфиопия — цветы и ягода. Кения — смородина и цитрус. Бразилия — орех и шоколад. Колумбия — баланс и сладость. Мытая — чище и кислотнее. Натуральная — ягоды и тело. Конкретная партия важнее страны на пакете."},{title:"Как говорить",steps:["Одно предложение про вкус, одно про метод.","Не оценивать «лучше/хуже».","Если гость хочет «помягче» — средняя обжарка, молоко или Kalita, не лекция о терруаре."]}]}];function qp({item:o,onClose:d}){const r=!!at().lessonsRead[o.id],C=Yu.find(y=>y.id===o.topicId);return s.jsx("div",{className:"fixed inset-0 z-50 flex items-end justify-center sm:items-center",style:{background:"rgba(10,14,14,.8)"},onClick:d,children:s.jsxs("div",{className:"anim-rise max-h-[88vh] w-full max-w-2xl overflow-y-auto rounded-t-3xl p-6 sm:rounded-3xl",style:{background:"#222a2a",border:"1px solid #33403f"},onClick:y=>y.stopPropagation(),children:[s.jsxs("div",{className:"flex items-start justify-between gap-4",children:[s.jsxs("div",{children:[s.jsxs("p",{className:"kicker",children:[C?.title," · ",o.duration]}),s.jsx("h2",{className:"font-display mt-1 text-xl font-bold",children:o.title}),s.jsx("p",{className:"mt-1 text-sm text-muted-foreground",children:o.summary})]}),s.jsx("button",{onClick:d,className:"btn-ghost-ind px-3 py-1.5 text-sm",children:"Закрыть"})]}),o.youtube&&s.jsxs("a",{href:`https://www.youtube.com/watch?v=${o.youtube.id}`,target:"_blank",rel:"noreferrer",className:"mt-5 flex items-center gap-4 rounded-2xl p-4 transition-transform hover:scale-[1.01]",style:{background:"#1a2121",border:"1px solid #EC462455"},children:[s.jsx("span",{className:"flex h-12 w-12 items-center justify-center rounded-full text-lg",style:{background:"#EC4624",color:"#fff"},children:"▶"}),s.jsxs("div",{children:[s.jsx("p",{className:"kicker",style:{color:"#EC4624"},children:"Видео-методика"}),s.jsx("p",{className:"mt-0.5 text-sm font-bold",children:o.youtube.title})]})]}),o.recipe&&s.jsx("div",{className:"mt-4 overflow-hidden rounded-2xl border border-border",children:s.jsx("table",{className:"w-full text-xs",children:s.jsx("tbody",{children:o.recipe.rows.m