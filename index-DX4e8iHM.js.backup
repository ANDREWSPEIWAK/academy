&s.jsxs("p",{className:"mt-2 text-sm",style:{color:"#c9c0a6"},children:["Верно: ",m.join(" → ")]}),s.jsx("button",{onClick:d,className:"btn-aqua mt-4 px-6 py-2.5 text-sm",children:"Готово"})]})]})})}function bp(){const o=at(),[d,m]=Y.useState(""),[r,C]=Y.useState("all"),[y,S]=Y.useState(null),[O,k]=Y.useState(null),B=Object.values(o.known).filter(Boolean).length,j=Y.useMemo(()=>{const E=d.trim().toLowerCase();return Un.filter(D=>r!=="all"&&D.category!==r?!1:E?[D.name,D.recipe.ru,D.taste.ru,D.method.ru,...D.steps.ru].join(" ").toLowerCase().includes(E):!0)},[d,r]);return s.jsxs("div",{className:"space-y-6",children:[s.jsxs("div",{className:"anim-rise",children:[s.jsx("p",{className:"kicker",children:"ТТК · техкарты станции"}),s.jsx("h1",{className:"font-display mt-2 text-3xl font-bold",children:"Рецепты и сборка"}),s.jsx("p",{className:"mt-2 text-sm text-muted-foreground",children:"Карточки: рецепт, вкус, метод, шаги. Отмечай «знаю» и тренируй сборку, пока меню не сядет в руки."})]}),s.jsxs("div",{className:"card-ind p-4 anim-rise",children:[s.jsxs("div",{className:"flex items-center justify-between text-xs text-muted-foreground",children:[s.jsx("span",{children:"Знаю рецептов"}),s.jsxs("span",{className:"font-mono2 tnum",style:{color:"#4FBBBC"},children:[B,"/79"]})]}),s.jsx("div",{className:"mt-2",children:s.jsx(Tt,{value:B/79*100,color:"#4FBBBC"})})]}),s.jsx("input",{value:d,onChange:E=>m(E.target.value),placeholder:"Поиск: flat white, раф, V60, мартини…",className:"w-full rounded-full px-5 py-3 text-sm outline-none anim-rise",style:{background:"#263030",border:"1px solid #33403f",color:"#e2dac2"}}),s.jsxs("div",{className:"no-scrollbar flex gap-2 overflow-x-auto pb-1 anim-rise",children:[s.jsx("button",{onClick:()=>C("all"),className:`chip-ind shrink-0 px-4 py-2 text-xs ${r==="all"?"on":""}`,children:"Все"}),Ln.map(E=>s.jsx("button",{onClick:()=>C(E.id),className:`chip-ind shrink-0 px-4 py-2 text-xs ${r===E.id?"on":""}`,children:E.title},E.id))]}),s.jsxs("div",{className:"space-y-2",children:[j.map((E,D)=>{const H=!!o.known[E.id];return s.jsxs("button",{onClick:()=>S(E),className:"card-ind card-ind-hover flex w-full items-center gap-3 p-4 text-left anim-rise",style:{animationDelay:`${Math.min(D,12)*30}ms`},children:[s.jsx("span",{className:"h-2.5 w-2.5 shrink-0 rounded-full",style:{background:H?"#4FBBBC":"#3a4a4a"}}),s.jsxs("div",{className:"min-w-0 flex-1",children:[s.jsx("p",{className:"text-sm font-bold",children:E.name}),s.jsx("p",{className:"truncate text-xs text-muted-foreground",children:E.recipe.ru})]}),s.jsx(Bt,{color:H?"#4FBBBC":"#8a8a76",children:Ln.find(V=>V.id===E.category)?.title})]},E.id)}),j.length===0&&s.jsx("p",{className:"py-8 text-center text-sm text-muted-foreground",children:"Ничего не найдено. Попробуй другой запрос."})]}),y&&!O&&s.jsx(xp,{recipe:y,onClose:()=>S(null),onTrain:()=>k(y)}),O&&s.jsx(vp,{recipe:O,onClose:()=>{k(null),S(null)}})]})}const _u=["Сервис и работа с гостем","Обслуживание и чистка техники","Фильтр-кофе и пуровер","Эспрессо"],Sp=[{id:"e1",n:1,block:"Сервис и работа с гостем",prompt:"Гость говорит: «Кофе слишком кислый». Какие 3–4 уточняющих вопроса вы зададите, прежде чем что-то менять?",model:"Что именно пьёте (эспрессо / американо / фильтр / молоко)? Обычно берёте этот напиток или впервые? Кислость режет или просто яркая? Сахар/молоко добавляли? Если фильтр — какой лот. Затем: предложить альтернативу (молочный, более тёмная обжарка) или переделать, не споря о «правильной кислотности»."},{id:"e2",n:2,block:"Сервис и работа с гостем",prompt:"Гость просит «самый крепкий кофе». Что уточните и какие варианты предложите?",model:"Уточнить: крепкий по кофеину, по телу или «чтобы взбодрило». Варианты: двойной эспрессо / ристретто, американо на двух шотах, лунго не равен крепости. Не обещать «самый крепкий в мире» — дать понятный выбор."},{id:"e3",n:3,block:"Сервис и работа с гостем",prompt:"В очереди 6 человек, один гость очень детально выбирает фильтр. Как не потерять остальных?",model:"Коротко зафиксировать выбор («сейчас подскажу два лота, остальное — пока готовлю»), параллельно принять заказы очереди. Не читать лекцию на кассе в пике. При необходимости позвать второго бариста на фильтр."},{id:"e4",n:4,block:"Сервис и работа с гостем",prompt:"Гость утверждает, что в чашке «волосок» или посторонний предмет. Первые действия?",model:"Извиниться, убрать чашку из зоны гостя, не спорить и не рассматривать предмет при всех. Переделать напиток в чистой посуде. Сообщить старшему. Разбор — после, не при госте. Не выбрасывать улику до фиксации."},{id:"e5",n:5,block:"Сервис и работа с гостем",prompt:"Как объяснить разницу между эспрессо, американо и лунго простыми словами?",model:"Эспрессо — маленький концентрированный шот. Американо — тот же шот, разбавленный горячей водой (вкус мягче, объём больше). Лунго — тот же помол тянут дольше/больше воды через таблетку, чаще горче и площе, это не «большой эспрессо»."},{id:"e6",n:6,block:"Сервис и работа с гостем",prompt:"Гость всегда просит капучино «очень горячим». Вы знаете, что выше ~70 °C молоко теряет сладость. Как ответить?",model:"Не спорить. Коротко: выше 70 °C молоко становится варёным и теряет сладость. Предложить «горячее комфортное» ~65 °C или уменьшить молоко / подать эспрессо отдельно. Если настаивает — выполнить и отметить в карточке гостя, без лекции."},{id:"e7",n:7,block:"Сервис и работа с гостем",prompt:"Что важнее: скорость или качество? Для утреннего пика и спокойного вечера.",model:"Пик: скорость внутри стандарта — не резать дозу и температуру ради секунд, но пропускать допродажу и разговоры. Вечер: качество и сервис, можно рекомендовать фильтр и рассказывать о зерне. Качество не падает ниже стандарта никогда."},{id:"e8",n:8,block:"Сервис и работа с гостем",prompt:"Капучино «пустой» и быстро оседает. Какие причины со стороны бариста проверить первым делом?",model:"Мало воздуха на растяжке или растяжка слишком долгая (крупные пузыри). Молоко перегрето. Эспрессо слабый/водянистый (недоэкстр). Грязный питчер. Молоко не из холодильника. Смешивание слишком агрессивное."},{id:"e9",n:9,block:"Сервис и работа с гостем",prompt:"Как работать с аллергией гостя (лактоза, орехи) при приготовлении?",model:"Принять всерьёз. Сменить питчер и стимер, промыть стимер. Отдельная ложка/сироп. Не обещать «абсолютный ноль», если на станции общий пар. Если риск кросс-контакта высок — честно сказать и предложить безопасный напиток."},{id:"e10",n:10,block:"Сервис и работа с гостем",prompt:"В меню новый фильтр Kalita Wave. Как коротко презентовать постоянному гостю, который берёт эспрессо?",model:"Одна фраза-история: «Сегодня на Kalita эфиопская с ягодой — чище и спокойнее эспрессо, без молока. Занять 3 минуты, могу сделать, пока пьёте шот». Одно предложение, без давления."},{id:"e11",n:11,block:"Обслуживание и чистка техники",prompt:"Обязательные действия в начале смены с кофемашиной и кофемолкой.",model:"Давление бойлера/групп, промывка групп холостыми проливами, температура воды, слепой тест ~9 бар. Молка: внешняя чистка, проверка бункера, прогрев, тестовый помол, сверка с журналом вчерашних настроек."},{id:"e12",n:12,block:"Обслуживание и чистка техники",prompt:"Как часто делать бэкфлаш и зачем?",model:"Ежедневно в конце смены на всех рабочих группах. Снимает масла, которые горчат и забивают группу. Со слепым диском и детергентом для эспрессо-групп, затем чистая вода до отсутствия химии."},{id:"e13",n:13,block:"Обслуживание и чистка техники",prompt:"Правильная последовательность ежедневной чистки кофемолки.",model:"Пустой бункер, щётка + продувка воронки и выхода, жернова сухой щёткой без разбора. Раз в 2 дня — таблетки по инструкции. Не мыть жернова моющим для посуды. Запись в журнале."},{id:"e14",n:14,block:"Обслуживание и чистка техники",prompt:"Что такое «слепой» холдер и когда его используют?",model:"Blind filter — глухой диск без отверстий. Для бэкфлаша и проверки давления группы. Не для приготовления кофе."},{id:"e15",n:15,block:"Обслуживание и чистка техники",prompt:"После промывки группы кофе отдаёт химией. Что не так и как исправить?",model:"Не вымыли детергент: мало финальных проливов без диска. Пролить чистой водой многократно, сделать 1–2 холостых с кофе в холдере в отход, пробовать. Не подавать гостю, пока привкус не ушёл."},{id:"e16",n:16,block:"Обслуживание и чистка техники",prompt:"Почему чистить стимер сразу после молока? Что будет, если не делать?",model:"Молоко присыхает в трубке, даёт бактерии, запах и брызги. Продуть пар, протереть влажной тканью сразу. Иначе забитый стимер и грязный вкус."},{id:"e17",n:17,block:"Обслуживание и чистка техники",prompt:"Как часто и чем чистить душ группы (shower screen)?",model:"Ежедневно — часть бэкфлаша. Еженедельно снимать решётку, замачивать в детергенте, щётка, промыть. Грязный душ = каналы и грязный вкус."},{id:"e18",n:18,block:"Обслуживание и чистка техники",prompt:"Молка греется, помол «уплывает» в смене. Какие причины проверить?",model:"Забитые жернова / файнсы, износ жерновов, слишком мелкий помол под нагрузкой, плохая вентиляция, переполненный бункер с тёплым зерном, неверная калибровка после чистки."},{id:"e19",n:19,block:"Обслуживание и чистка техники",prompt:"Что входит в еженедельную глубокую чистку машины (кроме ежедневного)?",model:"Снять и замочить души групп, чистка дренажа и поддона, холдеры и корзины, внешние панели, проверка уплотнителей, журнал фильтров воды, калибровка жерновов."},{id:"e20",n:20,block:"Обслуживание и чистка техники",prompt:"Почему нельзя оставлять остатки кофе в холдере между заказами?",model:"Отработанная таблетка продолжает отдавать горечь и влагу, корзина грязнится, следующий шот стартует с грязной сетки. Выбивать сразу."},{id:"e21",n:21,block:"Фильтр-кофе и пуровер",prompt:"Соотношение кофе к воде по Golden Cup для фильтра?",model:"55 г на 1 л воды (≈ 1:18), допуск ±10%. TDS 1,15–1,35%, экстракция 18–22%, вода 90–96 °C."},{id:"e22",n:22,block:"Фильтр-кофе и пуровер",prompt:"Пошагово стандартный рецепт Kalita Wave 185 (доза, температура, блум, пролив, время).",model:"ТТК: 21 г, фильтр Kalita Wave 185, выход 320 мл. Вода 92–96 °C. Промыть фильтр. Блум 30–40 г по всему плоскому слою. Первый пролив 120 мл, второй 150–160 мл до 320 мл. Не лить на волны. Плоское дно — ровный слой."},{id:"e23",n:23,block:"Фильтр-кофе и пуровер",prompt:"Зачем блум и сколько примерно воды и времени он занимает?",model:"Выпустить CO₂ и смочить всю массу. Около удвоенной дозы кофе, 30–45 секунд до оседания корки."},{id:"e24",n:24,block:"Фильтр-кофе и пуровер",prompt:"Почему у Kalita Wave плоское дно и три отверстия? Чем это лучше конического V60?",model:"Плоский слой = более ровная экстракция, меньше зависимость от техники пролива. Три отверстия ограничивают скорость. V60 конический — ярче и чувствительнее к руке; Kalita прощает и стабильнее на потоке."},{id:"e25",n:25,block:"Фильтр-кофе и пуровер",prompt:"Фильтр очень кислый и слабый. Какие 3 параметра изменить и в какую сторону?",model:"Помол мельче. Соотношение на крепче (больше кофе или меньше воды). Температура выше / дольше контакт. Не всё сразу — один параметр, проба."},{id:"e26",n:26,block:"Фильтр-кофе и пуровер",prompt:"Kalita стекает слишком быстро (меньше 2:00). Что это говорит о помоле?",model:"Помол слишком крупный (или мало кофе / дырявый фильтр). Сделать помол мельче, проверить дозу и посадку фильтра."},{id:"e27",n:27,block:"Фильтр-кофе и пуровер",prompt:"Зачем ополаскивать бумажный фильтр перед завариванием?",model:"Убрать бумажный привкус, прогреть воронку и сервер, прижать фильтр к стенкам, чтобы не было каналов по краю."},{id:"e28",n:28,block:"Фильтр-кофе и пуровер",prompt:"Оптимальная температура воды для светлых и средних обжарок в пуровере?",model:"90–96 °C, для светлых ближе к верхней границе (93–96). Слишком холодно — недоэкстракция."},{id:"e29",n:29,block:"Фильтр-кофе и пуровер",prompt:"Непрерывный пролив vs пульсовый. Когда что предпочтительнее?",model:"Непрерывный — стабильный уровень, мягче тело, требует контроля. Пульсы — проще управлять временем и турбулентностью, удобнее на Kalita и в обучении. Светлые яркие лоты часто лучше пульсами."},{id:"e30",n:30,block:"Фильтр-кофе и пуровер",prompt:"Гость: фильтр «горчит и вяжет». Что проверить и как скорректировать?",model:"Переэкстракция: помол крупнее, чуть ниже температура, короче контакт / меньше пульсов, не заливать края. Проверить свежесть и степень обжарки. Грязный чайник или фильтр без ополаскивания тоже горчит."},{id:"e31",n:31,block:"Эспрессо",prompt:"Что такое классический эспрессо по базовым параметрам (доза, выход, время)?",model:"ТТК станции: 18 г → 34–36 мл, 1:2, 25–30 с. Ложка и стакан воды. Цифры — старт диалина."},{id:"e32",n:32,block:"Эспрессо",prompt:"Последовательность приготовления эспрессо от помола до готового шота.",model:"Прогреть чашку и холдер. Смолоть в сухую чистую корзину. Распределить ровно. Темпинг вертикально, без наклона. Смахнуть края. В группу без задержки. Запуск, контроль веса/времени. Остановка на целевом выходе. Выбить таблетку, пролить группу, протереть корзину."},{id:"e33",n:33,block:"Эспрессо",prompt:"Что такое каналирование, как распознать и предотвратить?",model:"Вода пробивает слабые зоны таблетки. Признаки: брызги, дырки в таблетке, быстрое светление, кисло-горький вкус. Профилактика: ровный дистрибьют, ровный темпинг, чистая корзина, свежий помол, быстрая вставка в группу."},{id:"e34",n:34,block:"Эспрессо",prompt:"Шот вышел за 18 секунд и получился кислым. Что изменить и почему?",model:"Недоэкстракция из-за крупного помола (или низкой дозы). Помол мельче, проверить дозу и распределение. Не увеличивать выход ещё больше — это разбавит кислоту, не исправит экстракцию."},{id:"e35",n:35,block:"Эспрессо",prompt:"Шот идёт 40 секунд, мало жидкости, вкус горький и плоский. Действия?",model:"Переэкстракция / слишком мелкий помол или избыточный темпинг/доза. Помол крупнее. Проверить каналирование: иногда «долго и мало» — это забитая корзина, а не «крепкий» кофе."},{id:"e36",n:36,block:"Эспрессо",prompt:"Зачем темпинг и какой силы? Слишком слабый и слишком сильный.",model:"Создать равномерное сопротивление. Важнее ровность, чем сила: уверенное сжатие до упора, без «качка». Слабый — каналы. Сильный с наклоном — тоже каналы. Не лечит плохой дистрибьют."},{id:"e37",n:37,block:"Эспрессо",prompt:"Что такое ratio в эспрессо? Пример.",model:"Выход ÷ доза. 36 г из 18 г = 1:2. Ристретто ближе к 1:1–1:1.5, лунго к 1:3+. Ratio задаёт крепость и баланс вместе с временем."},{id:"e38",n:38,block:"Эспрессо",prompt:"Почему важно распределять кофе в холдере ровно перед темпингом?",model:"Комки и горка дают разную плотность. Вода идёт туда, где рыхлее. Ровный слой — ровная экстракция и предсказуемое время."},{id:"e39",n:39,block:"Эспрессо",prompt:"Как температура бойлера / группы влияет на вкус?",model:"Выше — больше экстракция, сладость, риск горечи и «печёности». Ниже — ярче кислота, риск пустоты и соли. Светлую обжарку часто ведут чуть горячее, тёмную — прохладнее."},{id:"e40",n:40,block:"Эспрессо",prompt:"В течение смены эспрессо начал выходить быстрее при том же помоле. Минимум 3 причины.",model:"Жернова нагрелись и режут иначе. Зерно в бункере нагрелось / потеряло влагу. Корзина грязная, каналы. Доза просела (недовес). Давление помпы упало. Сменилась партия в бункере. Бариста стал темпировать слабее."}],_n=[{id:"case-1",block:"Гость",scene:"Гость говорит: «Кофе слишком кислый». Твои первые действия?",options:[{text:"Объяснить, что у светлой обжарки кислотность — это норма спешелти",score:0},{text:"Уточнить: что пьёт, впервые ли этот напиток, кислость режет или просто яркая, добавлял ли сахар/молоко",score:2},{text:"Сразу переделать напиток без вопросов",score:1}],explain:"Сначала диагностика: 3–4 уточняющих вопроса. Потом решение — альтернатива (молочный, тёмная обжарка) или переделка. Спор о «правильной кислотности» — проигрыш всегда."},{id:"case-2",block:"Гость",scene:"Гость просит «самый крепкий кофе». Что предложишь?",options:[{text:"Лунго — он большой, значит крепкий",score:0},{text:"Двойной эспрессо или американо на двух шотах, уточнив: крепкий по кофеину, по телу или «чтобы взбодрило»",score:2},{text:"Раф с двумя шотами и сиропом",score:1}],explain:"Лунго ≠ крепость: тот же помол тянется дольше — горче и площе. Уточни, что для гостя «крепкий», и дай понятный выбор из 2 вариантов."},{id:"case-3",block:"Очередь",scene:"Очередь 6 человек, один гость детально выбирает фильтр уже минуту. Как поступить?",options:[{text:"Продолжить консультировать — сервис важнее скорости",score:0},{text:"Зафиксировать выбор («сейчас подскажу два лота, остальное — пока готовлю») и параллельно принять заказы очереди",score:2},{text:"Попросить гостя отойти и подумать в стороне",score:1}],explain:"В пике не читаем лекции на кассе. Фиксируем выбор коротко, двигаем очередь, при возможности зовём второго бариста на фильтр."},{id:"case-4",block:"Инцидент",scene:"Гость вернул чашку: внутри посторонний предмет. Порядок действий?",options:[{text:"Рассмотреть предмет при госте и определить, откуда он",score:0},{text:"Извиниться, убрать чашку из зоны гостя, переделать напиток в чистой посуде, сообщить старшему",score:2},{text:"Предложить скидку на следующий визит вместо переделки",score:1}],explain:"Не спорим и не исследуем при всех. Чашку — из зоны гостя, напиток — переделать, старшего — в курс. Предмет не выбрасывать до фиксации, разбор — после."},{id:"case-5",block:"Гость",scene:"Гость просит капучино «очень горячим». Ты знаешь: выше ~70 °C молоко теряет сладость.",options:[{text:"Отказать: стандарт есть стандарт",score:0},{text:"Нагреть до 80 °C — гость всегда прав",score:1},{text:"Коротко объяснить про сладость, предложить ~65 °C «горячее комфортное»; если настаивает — выполнить без лекции",score:2}],explain:"Не спорим, а предлагаем профессиональную альтернативу. Настаивает — выполняем и отмечаем предпочтение. Гость платит за свой вкус, не за нашу правоту."},{id:"case-6",block:"Аллергия",scene:"Гость с аллергией на лактозу просит капучино на безлактозном молоке.",options:[{text:"Взбить в том же питчере — после продува там всё чисто",score:0},{text:"Честно сказать, что на станции общий пар и нулевой риск не гарантируешь",score:1},{text:"Взять чистый питчер, промыть и продуть стимер, отдельная ложка; о риске кросс-контакта предупредить честно",score:2}],explain:"Аллергию принимаем всерьёз: чистый питчер, промытый стимер, отдельные аксессуары. И честность: «абсолютный ноль» при общем паре не обещаем — при высоком риске предлагаем безопасный напиток."},{id:"case-7",block:"Команда",scene:"Пик. Ты на шотах, питчер с молоком готовился 40 секунд назад и ждёт. Шот только запущен.",options:[{text:"Влить молоко как есть — гость не заметит",score:0},{text:"Молоко в отход, взбить свежее под новый шот — синхрон ±10 секунд",score:2},{text:"Поставить питчер в холодильник до следующего заказа",score:1}],explain:"Микропена расслаивается за десятки секунд: текстура мертва — латте-арт не соберётся, пена осядет. Молоко не ждёт шот: взбиваем заново."},{id:"case-8",block:"Станция",scene:"Молка в смене «плывёт»: время шота ушло с 27 до 20 секунд. Что проверить?",options:[{text:"Ничего — 20 секунд тоже нормально, гости не заметят",score:0},{text:"Помол мельче, проверить чистоту жерновов и нагрев молки, записать в журнал",score:2},{text:"Увеличить дозу кофе, чтобы компенсировать время",score:1}],explain:"20 секунд = недоэкстракция = кислый плоский шот. Причины «плавания»: нагрев жерновов, файнсы, износ. Крутим помол, чистим, фиксируем в журнале диалина."},{id:"case-9",block:"Очередь",scene:"В очереди на баре: латте, фильтр Kalita, капучино, американо. В каком порядке ставить в работу?",options:[{text:"Строго в порядке чеков: латте → фильтр → капучино → американо",score:1},{text:"Фильтр первым «фоном», затем шоты: латте+капучино парой на одном питчере, американо между",score:2},{text:"Сначала самые быстрые: американо, потом остальные по очереди",score:1}],explain:"Фильтр капает 3 минуты сам — ставим первым. Молочные батчим парами. Американо без молока — быстрый «затычкой» между шотами. Так очередь закрывается на 2–3 минуты быстрее."},{id:"case-10",block:"Сервис",scene:"Спокойный вечер, постоянный гость всегда берёт эспрессо. В меню новый лот на Kalita.",options:[{text:"Рассказать всё про лот: регион, обработку, дескрипторы, высоту",score:0},{text:"Одна фраза-история: «Сегодня на Kalita эфиопия с ягодой — чище и спокойнее эспрессо. 3 минуты, могу сделать, пока пьёте шот»",score:2},{text:"Ничего не предлагать — постоянные гости сами знают, что хотят",score:1}],explain:"Одно предложение, одна фраза, без давления. Вечер — время сервиса и историй, но даже здесь уважаем выбор гостя."},{id:"case-11",block:"Станция",scene:"После утреннего бэкфлаша гость говорит, что эспрессо «отдаёт химией».",options:[{text:"Объяснить, что машина просто чистая",score:0},{text:"Переделать напиток, пролить группу чистой водой многократно, сделать холостые шоты в отход, пробовать до ухода привкуса",score:2},{text:"Извиниться и предложить фильтр вместо эспрессо",score:1}],explain:"Привкус химии = детергент не вымыт: мало финальных проливов. Напиток — переделать, группу — проливать до чистого вкуса. Гостю не подаём, пока привкус не ушёл."},{id:"case-12",block:"Продажи",scene:"Гость заказывает большой латте с собой. Правильная допродажа?",options:[{text:"«А сироп, десерт, зерно домой, вторая порция?» — списком всё сразу",score:0},{text:"Молча пробить заказ — гость и так спешит",score:1},{text:"Одна фраза: «К латте отлично идёт круассан — добавить?»",score:2}],explain:"Одна конкретная допродажа в одну фразу конвертирует в разы лучше перечня. Никакого давления: отказ — с улыбкой, заказ — без паузы."}];function Fl(o){return[...o].sort(()=>Math.random()-.5)}function ym(o=10){const d=Fl(Un),m=[];for(const r of d){if(m.length>=o)break;const C=m.length%3;if(C===0){const y=Fl(Un.filter(O=>O.id!==r.id&&O.category===r.category));if(y.length<3)continue;const S=Fl([r.recipe.ru,...y.slice(0,3).map(O=>O.recipe.ru)]);m.push({prompt:`ТТК напитка «${r.name}»?`,options:S,correct:S.indexOf